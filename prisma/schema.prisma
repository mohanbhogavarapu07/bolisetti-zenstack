generator client {
  provider = "prisma-client-js"
}

enum GrievanceStatus {
  OPEN
  IN_REVIEW
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MediaType {
  IMAGE
  VIDEO
}

model User {
  id                String             @id() @default(cuid())
  firstName         String?
  lastName          String?
  email             String?            @unique()
  phoneNumber       String?            @unique()
  voterId           String?            @unique()
  profilePictureUrl String?
  address           String?
  description       String?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt()
  roleId            String?
  constituencyId    String?
  role              Role?              @relation(fields: [roleId], references: [id], onDelete: SetNull)
  constituency      Constituency?      @relation(fields: [constituencyId], references: [id], onDelete: SetNull)
  grievances        Grievance[]
  notifications     Notification[]
  comments          GrievanceComment[]
  sessions          Session[]
}

model Role {
  id        String   @id() @default(cuid())
  name      String   @unique()
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()
  users     User[]
}

model Constituency {
  id         String      @id() @default(cuid())
  name       String      @unique()
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt()
  users      User[]
  grievances Grievance[]
}

model Grievance {
  id             String               @id() @default(cuid())
  title          String
  description    String
  address        String
  area           String?
  status         GrievanceStatus      @default(OPEN)
  priority       Priority             @default(MEDIUM)
  createdAt      DateTime             @default(now())
  lastUpdated    DateTime             @updatedAt()
  userId         String
  constituencyId String?
  departmentId   String?
  statusId       String?
  mediaId        String?
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  constituency   Constituency?        @relation(fields: [constituencyId], references: [id], onDelete: SetNull)
  department     GrievanceDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  statusEnum     GrievanceStatusEnum? @relation(fields: [statusId], references: [id], onDelete: SetNull)
  media          Media?               @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  comments       GrievanceComment[]
}

model GrievanceDepartment {
  id         String      @id() @default(cuid())
  name       String      @unique()
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt()
  grievances Grievance[]
}

model GrievanceStatusEnum {
  id         String      @id() @default(cuid())
  name       String      @unique()
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt()
  grievances Grievance[]
}

model GrievanceComment {
  id          String    @id() @default(cuid())
  content     String
  createdAt   DateTime  @default(now())
  grievanceId String
  userId      String
  grievance   Grievance @relation(fields: [grievanceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model News {
  id        String   @id() @default(cuid())
  title     String
  content   String
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()
}

model Project {
  id            String   @id() @default(cuid())
  title         String
  description   String
  location      String?
  projectStatus String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt()
}

model ScheduleEvent {
  id            String   @id() @default(cuid())
  title         String
  description   String?
  location      String?
  eventDatetime DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt()
}

model Media {
  id         String      @id() @default(cuid())
  title      String
  mediaUrl   String
  type       MediaType
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt()
  grievances Grievance[]
}

model Notification {
  id          String   @id() @default(cuid())
  title       String
  description String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt()
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model VoterId {
  id        String   @id() @default(cuid())
  voterId   String   @unique()
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()
}

model Admin {
  id        String    @id() @default(cuid())
  firstName String
  lastName  String
  email     String    @unique()
  password  String
  isActive  Boolean   @default(true)
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt()
}

model OTP {
  id          String   @id() @default(cuid())
  phoneNumber String
  otp         String
  expiresAt   DateTime
  isUsed      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Session {
  id          String   @id() @default(cuid())
  userId      String
  phoneNumber String
  expiresAt   DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt()
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
