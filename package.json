{
  "name": "bolisetti-zenstack-service",
  "version": "1.0.0",
  "description": "ZenStack microservice for Bollisetti backend",
  "main": "dist/index.js",
  "scripts": {
    "prebuild": "npx prisma generate",
    "build": "tsc && node verify-build.js && echo 'Build completed successfully'",
    "start": "node index.js",
    "dev": "tsx watch src/index.ts",
    "generate": "zenstack generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "seed": "tsx seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@zenstackhq/runtime": "^2.19.2",
    "@zenstackhq/server": "^2.19.2",
    "@supabase/supabase-js": "^2.39.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.0.0",
    "prisma": "^5.7.0",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0",
    "zenstack": "^2.0.0"
  },
  "prisma": {
    "seed": "tsx src/seed.ts"
  }
}
